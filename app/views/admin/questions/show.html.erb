<h1> Question: <%=@question.body %> from test <%=@question.test.title %> </h1>
<li><%= link_to 'Edit', edit_admin_question_path(@question) %></li>
<li><%= link_to 'Delete', admin_question_path(@question), method: :delete, data: {confirm: "Are you sure?"} %></li>

<%=link_to 'New answer',new_admin_question_answer_path(@question) %>

<ol>
  <h3>Answers</h3>
  <%=render @question.answers %>
</ol>
<p><%= link_to 'Back to tests', admin_tests_path %></p>
